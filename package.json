{
    "name": "bmd-fusion-scripting",
    "displayName": "BMD Fusion Scripting",
    "description": "A collection of helping fusion scripting tools",
    "version": "1.2.0",
    "publisher": "EmberLightVFX",
    "icon": "resources/fusion-studio.png",
    "stubsInfo": {
        "name": "BMD Fusion Scripting",
        "version": 1.2
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/EmberLightVFX/BMD-Fusion-extension-for-VSCode.git"
    },
    "bugs": {
        "url": "https://github.com/EmberLightVFX/BMD-Fusion-extension-for-VSCode/issues"
    },
    "extensionKind": [
        "workspace"
    ],
    "categories": [
        "Snippets",
        "Extension Packs",
        "Education",
        "Other"
    ],
    "keywords": [
        "blackmagic design",
        "fusion",
        "scripting",
        "lua",
        "python",
        "stubs",
        "fuse"
    ],
    "engines": {
        "vscode": "^1.96.0"
    },
    "activationEvents": [
        "onLanguage:fuse",
        "onLanguage:python"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "fuse",
                "aliases": [
                    "Fuse"
                ],
                "extensions": [
                    ".fuse",
                    ".Fuse",
                    ".FUSE"
                ]
            }
        ],
        "grammars": [
            {
                "language": "fuse",
                "scopeName": "source.fuse",
                "path": "./syntaxes/fuse.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "bmd-fusion-scripting.checkFusionStubsUpdates",
                "title": "BMD Fusion: Check for updates"
            },
            {
                "command": "bmd-fusion-scripting.createVscodeLaunchConfig",
                "title": "BMD Fusion: Create launch config"
            },
            {
                "command": "bmd-fusion-scripting.copyFusionStubsToWorkspace",
                "title": "BMD Fusion: Copy Fusion stubs to workspace"
            }
        ],
        "debuggers": [
            {
                "type": "bmd-fusion-scripting",
                "label": "Launch Fusion Script"
            }
        ],
        "configuration": {
            "properties": {
                "stubInjector.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable the built-in stubs."
                },
                "stubInjector.additionalStubPaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional paths to include for stub definitions."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p .",
        "watch": "tsc -watch -p .",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.17.10",
        "@types/vscode": "^1.96.0",
        "@typescript-eslint/eslint-plugin": "^8.17.0",
        "@typescript-eslint/parser": "^8.17.0",
        "@vscode/test-cli": "^0.0.10",
        "@vscode/test-electron": "^2.4.1",
        "eslint": "^9.16.0",
        "typescript": "^5.7.2",
        "vscode-languageclient": "^9.0.1"
    },
    "homepage": "https://github.com/EmberLightVFX/BMD-Fusion-extension-for-VSCode#readme",
    "author": "",
    "license": "ISC",
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    }
}